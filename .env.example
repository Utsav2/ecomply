# Anthropic API — used for enrichment cache misses and scope-out rationale checks.
ANTHROPIC_API_KEY=
# Required only for identity-linked API keys (the workspace the key acts in).
ANTHROPIC_WORKSPACE_ID=
# Optional; defaults to claude-sonnet-5.
ANTHROPIC_MODEL=

# Upstash Redis (production/Vercel only). Leave unset locally to use the
# in-memory store. Both must be set together; the Vercel-KV names
# KV_REST_API_URL / KV_REST_API_TOKEN are accepted as aliases.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
